<Window x:Class="CalculatorApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CalculatorApp.ViewModels"
        mc:Ignorable="d"
        Title="Калькулятор" Height="520" Width="520">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="A:" Width="30" VerticalAlignment="Center" />
            <TextBox Width="140" Text="{Binding InputA, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="B:" Width="30" Margin="12,0,0,0" VerticalAlignment="Center" />
            <TextBox Width="140" Text="{Binding InputB, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="Операція:" Width="80" VerticalAlignment="Center" />
            <ComboBox Width="80" ItemsSource="{Binding Operations}" SelectedItem="{Binding SelectedOperation}" />
            <TextBlock Text="Режим:" Width="60" Margin="12,0,0,0" VerticalAlignment="Center" />
            <ComboBox Width="120" ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,0,0,8">
            <TextBlock Text="Округлення (N):" Width="140" VerticalAlignment="Center" />
            <TextBox Width="60" Text="{Binding RoundingDigits, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="(для Full)" Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <Button Grid.Row="3" Content="Обчислити" Width="120" Height="30" Command="{Binding CalculateCommand}" />

        <StackPanel Grid.Row="4" Margin="0,8,0,8">
            <TextBlock Text="Результат:" FontWeight="Bold" />
            <TextBlock Text="{Binding ResultText}" FontSize="16" />
            <TextBlock Text="{Binding ErrorText}" Foreground="DarkRed" Margin="0,4,0,0" />
        </StackPanel>

        <GroupBox Grid.Row="5" Header="Історія">
            <ListBox ItemsSource="{Binding History}" />
        </GroupBox>
    </Grid>
</Window>
